{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/eslint.config.mnci.mjs",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/package.json"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx-go/nx-go",
      "options": {
        "modulePrefix": "github.com/meta-ui-labs/cuppa"
      }
    }
  ],
  "analytics": false,
  "defaultBase": "main",
  "release": {
    "projectsRelationship": "independent",
    "projects": [
      "packages/*",
      "python-packages/*",
      "tag:type:vscode-extension",
      "tag:release:go",
      "!tag:type:go-lib"
    ],
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "git": {
      "commit": false,
      "tag": true,
      "push": true
    },
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk",
      "preVersionCommand": "npx nx run-many -t build --projects=packages/*,python-packages/*,tag:type:vscode-extension",
      "versionActionsOptions": {
        "skipLockFileUpdate": true
      },
      "preserveMatchingDependencyRanges": false
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": "github",
        "file": false
      },
      "automaticFromRef": true
    }
  },
  "generators": {
    "@nx/react:application": {
      "linter": "none",
      "unitTestRunner": "jest"
    },
    "@nx/react:library": {
      "linter": "none",
      "unitTestRunner": "jest"
    },
    "@nx/js:library": {
      "linter": "none",
      "unitTestRunner": "jest"
    }
  },
  "sync": {
    "applyChanges": true
  },
  "mnci": {
    "workspaceName": "cuppa",
    "scope": "@cuppa",
    "registry": {
      "kind": "npm"
    },
    "agent": "ubuntu-latest",
    "variableGroup": "Build",
    "ci": "github",
    "stack": {
      "testRunner": "jest"
    }
  }
}
